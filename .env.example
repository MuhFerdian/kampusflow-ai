# Web public build-time variables (web/.env.local):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Leave empty until a real FastAPI backend is deployed. On-device fallback remains available.
NEXT_PUBLIC_API_BASE_URL=

# Backend only (backend/.env); never prefix private keys with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Exact origins, no trailing slash. Use your actual HTTPS web origin in production.
CORS_ORIGINS=http://localhost:3000
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
MAX_TASKS=200
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=6
PORT=8080
